# Copia este archivo a .env y ajusta los valores.
DATABASE_URL="postgresql://puntoneutro:puntoneutro@localhost:5432/puntoneutro?schema=public"
# Base separada para los tests de la API (los tests limpian sus propias tablas).
TEST_DATABASE_URL="postgresql://puntoneutro:puntoneutro@localhost:5432/puntoneutro_test?schema=public"

# ── Supabase (ver SUPABASE.md) ──────────────────────────────────────────
# DATABASE_URL  → pooler en modo transacción (puerto 6543), lo usa la API.
# DIRECT_URL    → pooler en modo sesión (puerto 5432), lo usan las migraciones.
# DATABASE_SSL_CA → certificado de Supabase (PEM) para verificar la conexión.
# DATABASE_URL="postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Secreto para firmar las sesiones del panel (mínimo 32 caracteres en producción).
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-123456"
PORT=4000
# Primera cuenta administradora que crea el seed.
SEED_ADMIN_EMAIL="admin@puntoneutro.cl"
SEED_ADMIN_PASSWORD="PuntoNeutro2026!"
# Proxies delante de la API: 1 en local/hosting directo, 2 detrás de Cloudflare Pages.
TRUST_PROXY=1
