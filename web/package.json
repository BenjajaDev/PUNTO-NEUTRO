{
  "name": "web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sitio público y panel de administración de Punto Neutro (React + Vite).",
  "scripts": {
    "tokens": "node scripts/syncTokens.ts",
    "predev": "node scripts/syncTokens.ts",
    "dev": "vite",
    "prebuild": "node scripts/syncTokens.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/syncTokens.ts && tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
